# Required for V2 live prompt execution. Keep this file secret-free.
OPENAI_API_KEY=

# Optional OpenAI routing settings. Leave unset for the public OpenAI API.
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Optional LangSmith tracing. Set tracing to true only after supplying the key
# and project. Use the regional endpoint provisioned for your LangSmith tenant
# when applicable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=courtroom-simulation-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
