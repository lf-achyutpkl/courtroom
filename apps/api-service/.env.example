DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courtroom_simulation

REDIS_URL=redis://localhost:6379/0

TTS_PROVIDER=kokoro

R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=courtroom-simulation-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_REGION=auto

# Keep participant recordings private. Allow browser-origin PUT, Content-Type,
# and expose ETag in this R2 bucket's CORS rule; never configure a public URL.
INTERACTIVE_RECORDING_MIME_TYPES=audio/webm,audio/mp4,audio/ogg
INTERACTIVE_RECORDING_MAX_BYTES=10485760
INTERACTIVE_UPLOAD_EXPIRY_SECONDS=300
